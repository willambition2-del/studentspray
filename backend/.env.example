NODE_ENV=development
PORT=4000
HOST=127.0.0.1

DATABASE_URL=postgresql://quran_forum:quran_forum_dev@localhost:55432/quran_forum?schema=public

REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=
REDIS_DB=0

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SWAGGER_ENABLED=true
TRUST_PROXY=false

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=quran-forum-api
JWT_AUDIENCE=quran-forum-clients
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_HASH_SECRET=replace-with-another-32-character-random-secret

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_COOKIE_NAME=qf_refresh
AUTH_COOKIE_SAME_SITE=strict

# Used only by `npm run bootstrap:general-manager`; never commit a real password.
BOOTSTRAP_FORUM_SLUG=demo-quran-forum
BOOTSTRAP_USERNAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_BRANCH_CODE=
