}

model EvaluationCriterion {
  id          String             @id @default(uuid()) @db.Uuid
  axisId      String             @db.Uuid
  name        String
  description String?
  type        CriterionInputType @default(SCALE_5)
  maxScore    Decimal            @default(5.0) @db.Decimal(5, 2)
  weight      Decimal?           @db.Decimal(5, 2)
  isRequired  Boolean            @default(true)
  order       Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  axis        EvaluationAxis        @relation(fields: [axisId], references: [id], onDelete: Cascade)
  evaluations CriterionEvaluation[]

  @@index([axisId, order])
}

model FieldVisit {
  id               String      @id @default(uuid()) @db.Uuid
  forumId          String      @db.Uuid
  branchId         String      @db.Uuid
  supervisorId     String      @db.Uuid
  halaqaId         String      @db.Uuid
  teacherId        String      @db.Uuid
  visitNumber      String      @db.VarChar(40)
  visitType        VisitType   @default(ROUTINE)
  status           VisitStatus @default(PLANNED)
  scheduledDate    DateTime?   @db.Date
  startedAt        DateTime?
  completedAt      DateTime?
  reason           String?
  summary          String?
  generalNotes     String?
  createdById      String?     @db.Uuid
  clientMutationId String?     @unique @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  forum           Forum                 @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supervisor      SupervisorProfile     @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  halaqa          Halaqa                @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  teacher         TeacherProfile        @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  creator         User?                 @relation("FieldVisitCreator", fields: [createdById], references: [id], onDelete: SetNull)
  evaluation      FieldVisitEvaluation?
  recommendations Recommendation[]
  notes           SupervisorVisitNote[]

  @@index([forumId, branchId, supervisorId, status])
  @@index([halaqaId, status])
  @@index([teacherId, status])
}

model FieldVisitEvaluation {
  id                   String           @id @default(uuid()) @db.Uuid
  visitId              String           @unique @db.Uuid
  templateId           String           @db.Uuid
  templateVersion      Int              @default(1)
  templateNameSnapshot String
  status               EvaluationStatus @default(DRAFT)
  totalScore           Decimal          @default(0.0) @db.Decimal(6, 2)
  maxPossibleScore     Decimal          @default(100.0) @db.Decimal(6, 2)
  percentage           Decimal          @default(0.0) @db.Decimal(5, 2)
  level                EvaluationLevel?
  strengths            String?
  improvementAreas     String?
  summary              String?
  submittedAt          DateTime?
  clientMutationId     String?          @unique @db.Uuid
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  visit               FieldVisit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  template            EvaluationTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  criteriaEvaluations CriterionEvaluation[]

  @@index([visitId, status])
}

model CriterionEvaluation {
  id                    String   @id @default(uuid()) @db.Uuid
  evaluationId          String   @db.Uuid
  criterionId           String   @db.Uuid
  axisNameSnapshot      String
  criterionNameSnapshot String
  maxScoreSnapshot      Decimal  @db.Decimal(5, 2)
  weightSnapshot        Decimal? @db.Decimal(5, 2)
  score                 Decimal  @db.Decimal(5, 2)
  notApplicable         Boolean  @default(false)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  evaluation FieldVisitEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  EvaluationCriterion  @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, criterionId])
  @@index([evaluationId])
}

model Recommendation {
  id               String                 @id @default(uuid()) @db.Uuid
  forumId          String                 @db.Uuid
  branchId         String                 @db.Uuid
  visitId          String?                @db.Uuid
  halaqaId         String                 @db.Uuid
  teacherId        String                 @db.Uuid
  supervisorId     String                 @db.Uuid
  title            String
  description      String
  domain           String?
  priority         RecommendationPriority @default(MEDIUM)
  status           RecommendationStatus   @default(OPEN)
  dueDate          DateTime?              @db.Date
  completedAt      DateTime?
  createdById      String?                @db.Uuid
  clientMutationId String?                @unique @db.Uuid
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?

  forum      Forum                    @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch     Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  visit      FieldVisit?              @relation(fields: [visitId], references: [id], onDelete: SetNull)
  halaqa     Halaqa                   @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  teacher    TeacherProfile           @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  supervisor SupervisorProfile        @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  creator    User?                    @relation("RecommendationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  followUps  RecommendationFollowUp[]

  @@index([forumId, branchId, supervisorId, status])
  @@index([teacherId, status])
  @@index([halaqaId, status])
}

model RecommendationFollowUp {
  id               String               @id @default(uuid()) @db.Uuid
  recommendationId String               @db.Uuid
  status           RecommendationStatus
  notes            String
  createdById      String?              @db.Uuid
  clientMutationId String?              @unique @db.Uuid
  createdAt        DateTime             @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  creator        User?          @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([recommendationId, createdAt])
}

model SupervisorVisitNote {
  id             String   @id @default(uuid()) @db.Uuid
  visitId        String   @db.Uuid
  text           String
  isConfidential Boolean  @default(false)
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())

  visit   FieldVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  creator User?      @relation("SupervisorNoteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([visitId])
}

model Exam {
  id             String     @id @default(uuid()) @db.Uuid
  forumId        String     @db.Uuid
  branchId       String?    @db.Uuid
  academicYearId String?    @db.Uuid
  termId         String?    @db.Uuid
  halaqaId       String?    @db.Uuid
  title          String
  description    String?
  curriculum     String?
  examType       ExamType   @default(MONTHLY)
  scheduledDate  DateTime?  @db.Date
  startsAt       DateTime?
  endsAt         DateTime?
  maxScore       Decimal    @default(100.0) @db.Decimal(5, 2)
  passScore      Decimal    @default(60.0) @db.Decimal(5, 2)
  status         ExamStatus @default(DRAFT)
  isPublished    Boolean    @default(false)
  publishedAt    DateTime?
  createdById    String?    @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  forum        Forum           @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch       Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  academicYear AcademicYear?   @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  term         Term?           @relation(fields: [termId], references: [id], onDelete: SetNull)
  halaqa       Halaqa?         @relation(fields: [halaqaId], references: [id], onDelete: SetNull)
  creator      User?           @relation("ExamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  results      ExamResult[]
  criteria     ExamCriterion[]

  @@index([forumId, branchId, status])
  @@index([halaqaId, status])
  @@index([scheduledDate])
}

model ExamCriterion {
  id          String   @id @default(uuid()) @db.Uuid
  examId      String   @db.Uuid
  name        String
  description String?
  maxScore    Decimal  @default(10.0) @db.Decimal(5, 2)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, order])
}

model ExamResult {
  id               String           @id @default(uuid()) @db.Uuid
  examId           String           @db.Uuid
  studentId        String           @db.Uuid
  score            Decimal          @default(0.0) @db.Decimal(5, 2)
  percentage       Decimal          @default(0.0) @db.Decimal(5, 2)
  status           ExamResultStatus @default(ENTERED)
  isPassed         Boolean          @default(false)
  notes            String?
  criterionScores  Json?
  gradedById       String?          @db.Uuid
  gradedAt         DateTime?
  isPublished      Boolean          @default(false)
  publishedAt      DateTime?
  clientMutationId String?          @unique @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  exam    Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  grader  User?          @relation("ResultGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([examId, studentId])
  @@index([studentId, isPublished])
  @@index([examId, isPublished])
}

model StudentEvaluation {
  id             String                  @id @default(uuid()) @db.Uuid
  forumId        String                  @db.Uuid
  studentId      String                  @db.Uuid
  halaqaId       String                  @db.Uuid
  academicYearId String?                 @db.Uuid
  termId         String?                 @db.Uuid
  evaluationDate DateTime                @db.Date
  period         String?
  behaviorScore  Decimal?                @db.Decimal(5, 2)
  discipline     Decimal?                @db.Decimal(5, 2)
  participation  Decimal?                @db.Decimal(5, 2)
  overallScore   Decimal?                @db.Decimal(5, 2)
  rating         StudentEvaluationRating @default(VERY_GOOD)
  teacherNotes   String?
  actionLabel    String?
  isPublished    Boolean                 @default(true)
  publishedAt    DateTime?               @default(now())
  evaluatorId    String?                 @db.Uuid
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?

  forum        Forum          @relation(fields: [forumId], references: [id], onDelete: Restrict)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  halaqa       Halaqa         @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  academicYear AcademicYear?  @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  term         Term?          @relation(fields: [termId], references: [id], onDelete: SetNull)
  evaluator    User?          @relation("StudentEvaluator", fields: [evaluatorId], references: [id], onDelete: SetNull)

  @@index([studentId, evaluationDate])
  @@index([halaqaId, evaluationDate])
}

enum NotificationType {
  ATTENDANCE
  EXAM_RESULT
  STUDENT_EVALUATION
  MEMORIZATION
  REVISION
  FIELD_VISIT
  RECOMMENDATION
  NEW_MESSAGE
  ADMIN_REQUEST
  ADMIN_DECISION
  ADMIN_ALERT
  ADMIN_TASK
  SYSTEM
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform @default(ANDROID)
  deviceId   String?
  appVersion String?
  isActive   Boolean        @default(true)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum ConversationType {
  HALAQA
  STAFF
  PARENT_STUDENT_CHANNEL
}

enum ChatMessageType {
  TEXT
  SYSTEM
}

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  forumId   String           @db.Uuid
  type      ConversationType
  halaqaId  String?          @db.Uuid
  studentId String?          @db.Uuid
  title     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  forum    Forum                @relation(fields: [forumId], references: [id], onDelete: Restrict)
  halaqa   Halaqa?              @relation(fields: [halaqaId], references: [id], onDelete: Cascade)
  student  StudentProfile?      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages ChatMessage[]

  @@index([forumId, type])
  @@index([halaqaId])
  @@index([studentId])
}

model ConversationMember {
  id                String    @id @default(uuid()) @db.Uuid
  conversationId    String    @db.Uuid
  userId            String    @db.Uuid
  role              String?
  lastReadMessageId String?   @db.Uuid
  lastReadAt        DateTime?
  joinedAt          DateTime  @default(now())
  leftAt            DateTime?
  isActive          Boolean   @default(true)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isActive])
}

model ChatMessage {
  id              String          @id @default(uuid()) @db.Uuid
  conversationId  String          @db.Uuid
  senderId        String          @db.Uuid
  clientMessageId String?         @unique @db.Uuid
  type            ChatMessageType @default(TEXT)
  text            String
  metadata        Json?
  createdAt       DateTime        @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

// ==========================================
// PHASE 13: ACTIVITIES, COMPETITIONS, AWARDS & SHELF
// ==========================================

enum ActivityType {
  CONTEST
  TRIP
  PROGRAM
  COURSE
  MEETING
  SPORTS
  ENTERTAINMENT
  EDUCATIONAL
  QURANIC
  INITIATIVE
  CAMPAIGN
  CEREMONY
  CAMP
  OTHER
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ParticipantNominationStatus {
  NOMINATED
  APPROVED
  REJECTED
}

enum ParticipantAttendanceStatus {
  NOT_RECORDED
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum CompetitionCategory {
  MEMORIZATION
  TAJWEED
  RECITATION
  INTERPRETATION
  GENERAL_KNOWLEDGE
  HADITH
  CALLIGRAPHY
  OTHER
}

enum CompetitionStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  RESULTS_PUBLISHED
  CANCELLED
}

enum AwardType {
  MEDAL
  BADGE
  SHIELD
  CERTIFICATE
  POINTS
  HONORARY
}

enum ShelfContentType {
  ANNOUNCEMENT
  ARTICLE
  BOOK
  CURRICULUM
  RESOURCE
  ACTIVITY_RESULT
  EXAM_ANNOUNCEMENT
  GENERAL
}

enum ShelfVisibility {
  ALL_USERS
  STAFF_ONLY
  TEACHERS_ONLY
  STUDENTS_ONLY
  PARENTS_ONLY
}

model Activity {
  id          String         @id @default(uuid()) @db.Uuid
  forumId     String         @db.Uuid
  branchId    String?        @db.Uuid
  halaqaId    String?        @db.Uuid
  title       String
  description String?
  type        ActivityType   @default(EDUCATIONAL)
  status      ActivityStatus @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  capacity    Int?
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  forum        Forum                 @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch       Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  halaqa       Halaqa?               @relation(fields: [halaqaId], references: [id], onDelete: SetNull)
  creator      User?                 @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants ActivityParticipant[]
  awards       StudentAward[]

  @@index([forumId, status, deletedAt])
  @@index([branchId])
  @@index([halaqaId])
  @@index([startsAt])
}

model ActivityParticipant {
  id                   String                      @id @default(uuid()) @db.Uuid
  activityId           String                      @db.Uuid
  studentId            String                      @db.Uuid
  nominationStatus     ParticipantNominationStatus @default(NOMINATED)
  parentApprovalStatus String                      @default("NOT_REQUIRED")
  attendanceStatus     ParticipantAttendanceStatus @default(NOT_RECORDED)
  score                Float?
  notes                String?
  registeredAt         DateTime                    @default(now())

  activity Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([activityId, studentId])
  @@index([studentId])
}

model Competition {
  id          String              @id @default(uuid()) @db.Uuid
  forumId     String              @db.Uuid
  branchId    String?             @db.Uuid
  title       String
  description String?
  category    CompetitionCategory @default(MEMORIZATION)
  status      CompetitionStatus   @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime?
  maxScore    Float               @default(100)
  criteria    Json?
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  forum        Forum                    @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch       Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  creator      User?                    @relation("CompetitionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants CompetitionParticipant[]
  results      CompetitionResult[]
  awards       StudentAward[]

  @@index([forumId, status, deletedAt])
  @@index([branchId])
  @@index([startsAt])
}

model CompetitionParticipant {
  id            String   @id @default(uuid()) @db.Uuid
  competitionId String   @db.Uuid
  studentId     String   @db.Uuid
  registeredAt  DateTime @default(now())

  competition Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([competitionId, studentId])
  @@index([studentId])
}

model CompetitionResult {
  id            String    @id @default(uuid()) @db.Uuid
  competitionId String    @db.Uuid
  studentId     String    @db.Uuid
  score         Float
  rank          Int?
  notes         String?
  publishedAt   DateTime?
  gradedById    String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  competition Competition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grader      User?          @relation("CompetitionResultGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([competitionId, studentId])
  @@index([studentId])
  @@index([competitionId, rank])
}

model Award {
  id          String    @id @default(uuid()) @db.Uuid
  forumId     String    @db.Uuid
  name        String
  description String?
  iconKey     String?
  type        AwardType @default(BADGE)
  points      Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  forum         Forum          @relation(fields: [forumId], references: [id], onDelete: Restrict)
  studentAwards StudentAward[]

  @@index([forumId, isActive, deletedAt])
}

model StudentAward {
  id            String   @id @default(uuid()) @db.Uuid
  awardId       String   @db.Uuid
  studentId     String   @db.Uuid
  reason        String
  activityId    String?  @db.Uuid
  competitionId String?  @db.Uuid
  awardedById   String?  @db.Uuid
  awardedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  award       Award          @relation(fields: [awardId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activity    Activity?      @relation(fields: [activityId], references: [id], onDelete: SetNull)
  competition Competition?   @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  awardedBy   User?          @relation("AwardGrantor", fields: [awardedById], references: [id], onDelete: SetNull)

  @@index([studentId, awardedAt])
  @@index([awardId])
}

model ShelfSection {
  id          String          @id @default(uuid()) @db.Uuid
  forumId     String          @db.Uuid
  name        String
  slug        String
  description String?
  order       Int             @default(0)
  isActive    Boolean         @default(true)
  visibility  ShelfVisibility @default(ALL_USERS)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  forum          Forum                @relation(fields: [forumId], references: [id], onDelete: Restrict)
  items          ShelfItem[]
  publisherRules ShelfPublisherRule[]

  @@unique([forumId, slug])
  @@index([forumId, isActive, deletedAt])
}

model ShelfItem {
  id             String           @id @default(uuid()) @db.Uuid
  forumId        String           @db.Uuid
  sectionId      String           @db.Uuid
  title          String
  content        String           @db.Text
  type           ShelfContentType @default(GENERAL)
  attachmentName String?
  attachmentUrl  String?
  fileType       String?
  fileSize       String?
  isPinned       Boolean          @default(false)
  isPublished    Boolean          @default(true)
  publishedAt    DateTime?        @default(now())
  targetAudience ShelfVisibility  @default(ALL_USERS)
  authorId       String?          @db.Uuid
  authorName     String?
  authorRole     String?
  downloadCount  Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  forum   Forum        @relation(fields: [forumId], references: [id], onDelete: Restrict)
  section ShelfSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  author  User?        @relation("ShelfItemAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([forumId, sectionId, isPublished, deletedAt])
  @@index([isPinned, publishedAt])
}

model ShelfPublisherRule {
  id         String   @id @default(uuid()) @db.Uuid
  sectionId  String   @db.Uuid
  roleId     String?  @db.Uuid
  userId     String?  @db.Uuid
  canCreate  Boolean  @default(true)
  canPublish Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  section ShelfSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  role    Role?        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user    User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectionId, roleId, userId])
  @@index([sectionId])
  @@index([userId])
}

enum AdminRequestType {
  LEAVE
  TRANSFER
  EXCEPTION
  CURRICULUM_MODIFICATION
  ACTIVITY_PROPOSAL
  BUDGET_REQUEST
  GENERAL
}

enum AdminRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum AdminPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ApprovalActionType {
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum AdminDecisionType {
  HIRE_TEACHER
  TRANSFER_TEACHER
  HIRE_SUPERVISOR
  OPEN_HALAQA
  CLOSE_HALAQA
  MERGE_HALAQAT
  TRANSFER_STUDENT
  APPROVE_PROJECT
  APPROVE_ACTIVITY
  GENERAL_DIRECTIVE
}

enum AdminDecisionStatus {
  DRAFT
  ISSUED
  ACTIVE
  CANCELLED
  ARCHIVED
}

enum DecisionTargetType {
  ALL_FORUM
  BRANCH
  ROLE
  HALAQA
  USER
}

enum AdminAlertType {
  TASK_OVERDUE
  REQUEST_PENDING
  RECOMMENDATION_OVERDUE
  ATTENDANCE_CRITICAL
  EXAM_REVIEW_NEEDED
  CUSTOM
}

enum AdminAlertSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum AdminAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum AdminTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model AdministrativeRequest {
  id                String             @id @default(uuid()) @db.Uuid
  forumId           String             @db.Uuid
  branchId          String?            @db.Uuid
  type              AdminRequestType   @default(GENERAL)
  title             String             @db.VarChar(255)
  description       String             @db.Text
  requestedById     String             @db.Uuid
  relatedEntityType String?            @db.VarChar(80)
  relatedEntityId   String?            @db.VarChar(128)
  status            AdminRequestStatus @default(DRAFT)
  priority          AdminPriority      @default(NORMAL)
  submittedAt       DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  forum           Forum            @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  requestedBy     User             @relation("AdminRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvalActions ApprovalAction[]
  decisions       AdminDecision[]
  tasks           AdminTask[]

  @@index([forumId, branchId, status, deletedAt])
  @@index([requestedById, status])
  @@index([createdAt])
}

model ApprovalAction {
  id        String             @id @default(uuid()) @db.Uuid
  requestId String             @db.Uuid
  actorId   String             @db.Uuid
  action    ApprovalActionType
  comment   String?            @db.Text
  createdAt DateTime           @default(now())

  request AdministrativeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User                  @relation("ApprovalActionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([actorId])
}

model AdminDecision {
  id               String              @id @default(uuid()) @db.Uuid
  forumId          String              @db.Uuid
  branchId         String?             @db.Uuid
  decisionNumber   String              @db.VarChar(50)
  title            String              @db.VarChar(255)
  content          String              @db.Text
  type             AdminDecisionType   @default(GENERAL_DIRECTIVE)
  status           AdminDecisionStatus @default(DRAFT)
  issuedById       String              @db.Uuid
  issuedAt         DateTime            @default(now())
  effectiveFrom    DateTime?
  effectiveUntil   DateTime?
  relatedRequestId String?             @db.Uuid
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  forum          Forum                  @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch         Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  issuedBy       User                   @relation("AdminDecisionIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  relatedRequest AdministrativeRequest? @relation(fields: [relatedRequestId], references: [id], onDelete: SetNull)
  audiences      DecisionAudience[]
  tasks          AdminTask[]

  @@unique([forumId, decisionNumber])
  @@index([forumId, branchId, status, deletedAt])
  @@index([issuedById])
  @@index([issuedAt])
}

model DecisionAudience {
  id         String             @id @default(uuid()) @db.Uuid
  decisionId String             @db.Uuid
  targetType DecisionTargetType
  targetId   String?            @db.VarChar(128)

  decision AdminDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, targetType])
}

model AdminAlert {
  id                String             @id @default(uuid()) @db.Uuid
  forumId           String             @db.Uuid
  branchId          String?            @db.Uuid
  type              AdminAlertType     @default(CUSTOM)
  severity          AdminAlertSeverity @default(INFO)
  title             String             @db.VarChar(255)
  message           String             @db.Text
  relatedEntityType String?            @db.VarChar(80)
  relatedEntityId   String?            @db.VarChar(128)
  assignedToId      String?            @db.Uuid
  status            AdminAlertStatus   @default(OPEN)
  dueAt             DateTime?
  resolvedAt        DateTime?
  resolvedById      String?            @db.Uuid
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  forum      Forum       @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedTo User?       @relation("AdminAlertAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy User?       @relation("AdminAlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  tasks      AdminTask[]

  @@index([forumId, branchId, status, severity])
  @@index([assignedToId, status])
  @@index([createdAt])
}

model AdminTask {
  id                String          @id @default(uuid()) @db.Uuid
  forumId           String          @db.Uuid
  branchId          String?         @db.Uuid
  title             String          @db.VarChar(255)
  description       String?         @db.Text
  assignedToId      String          @db.Uuid
  createdById       String          @db.Uuid
  relatedDecisionId String?         @db.Uuid
  relatedRequestId  String?         @db.Uuid
  relatedAlertId    String?         @db.Uuid
  priority          AdminPriority   @default(NORMAL)
  status            AdminTaskStatus @default(OPEN)
  dueAt             DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  forum           Forum                  @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch          Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedTo      User                   @relation("AdminTaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy       User                   @relation("AdminTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  relatedDecision AdminDecision?         @relation(fields: [relatedDecisionId], references: [id], onDelete: SetNull)
  relatedRequest  AdministrativeRequest? @relation(fields: [relatedRequestId], references: [id], onDelete: SetNull)
  relatedAlert    AdminAlert?            @relation(fields: [relatedAlertId], references: [id], onDelete: SetNull)
  followUps       TaskFollowUp[]

  @@index([forumId, branchId, status, deletedAt])
  @@index([assignedToId, status])
  @@index([createdById])
  @@index([dueAt])
}

model TaskFollowUp {
  id        String           @id @default(uuid()) @db.Uuid
  taskId    String           @db.Uuid
  actorId   String           @db.Uuid
  status    AdminTaskStatus?
  note      String           @db.Text
  createdAt DateTime         @default(now())

  task  AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User      @relation("TaskFollowUpActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([actorId])
}
