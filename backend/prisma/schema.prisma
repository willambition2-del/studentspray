generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GuardianRelationship {
  FATHER
  MOTHER
  BROTHER
  UNCLE
  GUARDIAN
  OTHER
}

enum HalaqaMemberStatus {
  ACTIVE
  PAUSED
  COMPLETED
  WITHDRAWN
}

enum AuthClient {
  WEB
  MOBILE
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  ROTATED
  REUSE_DETECTED
  PASSWORD_CHANGED
  ACCOUNT_DISABLED
  EXPIRED
}

enum SecurityAuditEvent {
  LOGIN_SUCCESS
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
  LOGOUT
  LOGOUT_ALL
  REFRESH_REUSE_DETECTED
  SESSION_REVOKED
}

enum EducationalPlanType {
  HIFZ
  MURAJAAH
  CUSTOM
}

enum EducationalPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum PlanItemType {
  MEMORIZATION
  REVISION
  RECITATION
  OTHER
}

enum PlanItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TargetType {
  VERSES
  PAGES
  JUZ
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SessionStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum RecitationRating {
  EXCELLENT
  VERY_GOOD
  GOOD
  ACCEPTABLE
  NEEDS_REVIEW
}

model Forum {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  logo      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches            Branch[]
  users               User[]
  roles               Role[]
  halaqas             Halaqa[]
  academicYears       AcademicYear[]
  educationalPlans    EducationalPlan[]
  attendanceSessions  AttendanceSession[]
  memorizationRecords MemorizationRecord[]
  revisionRecords     RevisionRecord[]

  @@index([isActive, deletedAt])
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  forumId   String    @db.Uuid
  name      String
  code      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  forum            Forum             @relation(fields: [forumId], references: [id], onDelete: Restrict)
  users            User[]
  halaqas          Halaqa[]
  roleScopes       UserRole[]
  educationalPlans EducationalPlan[]

  @@unique([forumId, code])
  @@index([forumId, isActive, deletedAt])
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  forumId             String    @db.Uuid
  branchId            String?   @db.Uuid
  username            String
  displayName         String?
  usernameNormalized  String
  email               String?
  emailNormalized     String?
  phone               String?
  phoneNormalized     String?
  passwordHash        String?
  passwordChangedAt   DateTime?
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  forum                     Forum                @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch                    Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  roles                     UserRole[]
  studentProfile            StudentProfile?
  parentProfile             ParentProfile?
  teacherProfile            TeacherProfile?
  supervisorProfile         SupervisorProfile?
  authSessions              AuthSession[]
  securityAuditLogs         SecurityAuditLog[]
  businessAuditLogs         AuditLog[]
  createdPlans              EducationalPlan[]    @relation("PlanCreator")
  recordedSessions          AttendanceSession[]  @relation("SessionRecorder")
  recordedAttendanceRecords AttendanceRecord[]   @relation("AttendanceRecorder")
  recordedMemorizations     MemorizationRecord[] @relation("MemorizationRecorder")
  recordedRevisions         RevisionRecord[]     @relation("RevisionRecorder")

  @@unique([forumId, username])
  @@unique([forumId, usernameNormalized])
  @@unique([forumId, email])
  @@unique([forumId, emailNormalized])
  @@unique([forumId, phone])
  @@unique([forumId, phoneNormalized])
  @@index([forumId, branchId, isActive, deletedAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @db.VarChar(80)
  entityId    String?  @db.VarChar(128)
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(512)
  requestId   String?  @db.VarChar(128)
  createdAt   DateTime @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
}

model AuthSession {
  id                  String                   @id @default(uuid()) @db.Uuid
  userId              String                   @db.Uuid
  refreshTokenHash    String                   @unique
  tokenFamilyId       String                   @db.Uuid
  client              AuthClient
  lastUsedAt          DateTime?
  expiresAt           DateTime
  revokedAt           DateTime?
  revokedReason       SessionRevocationReason?
  replacedBySessionId String?                  @unique @db.Uuid
  ipAddress           String?                  @db.VarChar(45)
  userAgent           String?                  @db.VarChar(512)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy AuthSession? @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces   AuthSession? @relation("SessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@index([tokenFamilyId])
}

model SecurityAuditLog {
  id          String             @id @default(uuid()) @db.Uuid
  actorUserId String?            @db.Uuid
  event       SecurityAuditEvent
  success     Boolean
  ipAddress   String?            @db.VarChar(45)
  userAgent   String?            @db.VarChar(512)
  requestId   String?            @db.VarChar(128)
  metadata    Json?
  createdAt   DateTime           @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([event, createdAt])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  forumId     String   @db.Uuid
  name        String
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  forum       Forum            @relation(fields: [forumId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([forumId, name])
  @@index([forumId, isActive])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  branchId  String?   @db.Uuid
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([userId, isActive])
  @@index([roleId, branchId, isActive])
}

model StudentProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  studentNumber  String?
  dateOfBirth    DateTime? @db.Date
  enrollmentDate DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardians           StudentGuardian[]
  halaqaMemberships   HalaqaMember[]
  educationalPlans    EducationalPlan[]
  attendanceRecords   AttendanceRecord[]
  memorizationRecords MemorizationRecord[]
  revisionRecords     RevisionRecord[]

  @@index([studentNumber])
}

model ParentProfile {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @db.Uuid
  occupation String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentGuardian[]
}

model TeacherProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  employeeNumber String?
  specialization String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  halaqas HalaqaTeacher[]

  @@index([employeeNumber])
}

model SupervisorProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  employeeNumber String?
  specialization String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  halaqas HalaqaSupervisor[]

  @@index([employeeNumber])
}

model StudentGuardian {
  id                      String               @id @default(uuid()) @db.Uuid
  studentId               String               @db.Uuid
  parentId                String               @db.Uuid
  relationship            GuardianRelationship @default(FATHER)
  isPrimary               Boolean              @default(true)
  canPickup               Boolean              @default(true)
  receivesAcademicReports Boolean              @default(true)
  receivesFinancialAlerts Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId])
}

model Halaqa {
  id          String    @id @default(uuid()) @db.Uuid
  forumId     String    @db.Uuid
  branchId    String    @db.Uuid
  name        String
  code        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  forum               Forum                @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  members             HalaqaMember[]
  teachers            HalaqaTeacher[]
  supervisors         HalaqaSupervisor[]
  educationalPlans    EducationalPlan[]
  attendanceSessions  AttendanceSession[]
  memorizationRecords MemorizationRecord[]
  revisionRecords     RevisionRecord[]

  @@unique([branchId, code])
  @@index([forumId, branchId, isActive, deletedAt])
}

model HalaqaMember {
  id        String             @id @default(uuid()) @db.Uuid
  halaqaId  String             @db.Uuid
  studentId String             @db.Uuid
  status    HalaqaMemberStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  endedAt   DateTime?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  halaqa  Halaqa         @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([halaqaId, isActive])
  @@index([studentId, isActive])
}

model HalaqaTeacher {
  id        String    @id @default(uuid()) @db.Uuid
  halaqaId  String    @db.Uuid
  teacherId String    @db.Uuid
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  halaqa  Halaqa         @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([halaqaId, isActive])
  @@index([teacherId, isActive])
}

model HalaqaSupervisor {
  id           String    @id @default(uuid()) @db.Uuid
  halaqaId     String    @db.Uuid
  supervisorId String    @db.Uuid
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  halaqa     Halaqa            @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  supervisor SupervisorProfile @relation(fields: [supervisorId], references: [id], onDelete: Restrict)

  @@index([halaqaId, isActive])
  @@index([supervisorId, isActive])
}

model AcademicYear {
  id        String    @id @default(uuid()) @db.Uuid
  forumId   String    @db.Uuid
  name      String    @db.VarChar(120)
  startsAt  DateTime  @db.Date
  endsAt    DateTime  @db.Date
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  forum Forum  @relation(fields: [forumId], references: [id], onDelete: Restrict)
  terms Term[]

  @@unique([forumId, name])
  @@index([forumId, isActive, deletedAt])
}

model Term {
  id             String    @id @default(uuid()) @db.Uuid
  academicYearId String    @db.Uuid
  name           String    @db.VarChar(120)
  startsAt       DateTime  @db.Date
  endsAt         DateTime  @db.Date
  order          Int       @default(1)
  isActive       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  plans        EducationalPlan[]

  @@index([academicYearId, isActive, deletedAt])
}

model EducationalPlan {
  id          String                @id @default(uuid()) @db.Uuid
  forumId     String                @db.Uuid
  branchId    String?               @db.Uuid
  halaqaId    String?               @db.Uuid
  studentId   String?               @db.Uuid
  termId      String?               @db.Uuid
  name        String                @db.VarChar(150)
  type        EducationalPlanType   @default(HIFZ)
  status      EducationalPlanStatus @default(DRAFT)
  startDate   DateTime?             @db.Date
  endDate     DateTime?             @db.Date
  createdById String?               @db.Uuid
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  forum   Forum                 @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch  Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  halaqa  Halaqa?               @relation(fields: [halaqaId], references: [id], onDelete: SetNull)
  student StudentProfile?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  term    Term?                 @relation(fields: [termId], references: [id], onDelete: SetNull)
  creator User?                 @relation("PlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items   EducationalPlanItem[]

  @@index([forumId, halaqaId, status])
  @@index([studentId, status])
}

model EducationalPlanItem {
  id          String         @id @default(uuid()) @db.Uuid
  planId      String         @db.Uuid
  type        PlanItemType   @default(MEMORIZATION)
  targetType  TargetType     @default(VERSES)
  surahNumber Int?
  fromAyah    Int?
  toAyah      Int?
  pageFrom    Int?
  pageTo      Int?
  juzNumber   Int?
  targetDate  DateTime?      @db.Date
  order       Int            @default(1)
  status      PlanItemStatus @default(PENDING)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  plan                EducationalPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  memorizationRecords MemorizationRecord[]
  revisionRecords     RevisionRecord[]

  @@index([planId, order])
}

model AttendanceSession {
  id           String        @id @default(uuid()) @db.Uuid
  forumId      String        @db.Uuid
  halaqaId     String        @db.Uuid
  sessionDate  DateTime      @db.Date
  startedAt    DateTime?
  endedAt      DateTime?
  status       SessionStatus @default(COMPLETED)
  notes        String?
  recordedById String?       @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  forum    Forum              @relation(fields: [forumId], references: [id], onDelete: Restrict)
  halaqa   Halaqa             @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  recorder User?              @relation("SessionRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  records  AttendanceRecord[]

  @@unique([halaqaId, sessionDate])
  @@index([forumId, halaqaId, sessionDate])
}

model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  sessionId    String           @db.Uuid
  studentId    String           @db.Uuid
  status       AttendanceStatus @default(PRESENT)
  notes        String?
  recordedById String?          @db.Uuid
  recordedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  session  AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student  StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recorder User?             @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([studentId, recordedAt])
}

model MemorizationRecord {
  id               String            @id @default(uuid()) @db.Uuid
  forumId          String            @db.Uuid
  halaqaId         String            @db.Uuid
  studentId        String            @db.Uuid
  planItemId       String?           @db.Uuid
  date             DateTime          @db.Date
  surahNumber      Int
  fromAyah         Int
  toAyah           Int
  pageFrom         Int?
  pageTo           Int?
  evaluationScore  Decimal           @default(100.0) @db.Decimal(5, 2)
  rating           RecitationRating?
  mistakesCount    Int               @default(0)
  teacherNotes     String?
  recordedById     String?           @db.Uuid
  clientMutationId String?           @unique @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  forum    Forum                @relation(fields: [forumId], references: [id], onDelete: Restrict)
  halaqa   Halaqa               @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  student  StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  planItem EducationalPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  recorder User?                @relation("MemorizationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([studentId, date])
  @@index([halaqaId, date])
}

model RevisionRecord {
  id               String            @id @default(uuid()) @db.Uuid
  forumId          String            @db.Uuid
  halaqaId         String            @db.Uuid
  studentId        String            @db.Uuid
  planItemId       String?           @db.Uuid
  date             DateTime          @db.Date
  surahNumber      Int?
  fromAyah         Int?
  toAyah           Int?
  pageFrom         Int?
  pageTo           Int?
  juzNumber        Int?
  evaluationScore  Decimal           @default(100.0) @db.Decimal(5, 2)
  rating           RecitationRating?
  mistakesCount    Int               @default(0)
  teacherNotes     String?
  recordedById     String?           @db.Uuid
  clientMutationId String?           @unique @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  forum    Forum                @relation(fields: [forumId], references: [id], onDelete: Restrict)
  halaqa   Halaqa               @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  student  StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  planItem EducationalPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  recorder User?                @relation("RevisionRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([studentId, date])
  @@index([halaqaId, date])
}
