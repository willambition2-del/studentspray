generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum GuardianRelationship {
  FATHER
  MOTHER
  BROTHER
  UNCLE
  GUARDIAN
  OTHER
}

enum HalaqaMemberStatus {
  ACTIVE
  PAUSED
  COMPLETED
  WITHDRAWN
}

enum AuthClient {
  WEB
  MOBILE
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  ROTATED
  REUSE_DETECTED
  PASSWORD_CHANGED
  ACCOUNT_DISABLED
  EXPIRED
}

enum SecurityAuditEvent {
  LOGIN_SUCCESS
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
  LOGOUT
  LOGOUT_ALL
  REFRESH_REUSE_DETECTED
  SESSION_REVOKED
}

enum EducationalPlanType {
  HIFZ
  MURAJAAH
  CUSTOM
}

enum EducationalPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum PlanItemType {
  MEMORIZATION
  REVISION
  RECITATION
  OTHER
}

enum PlanItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TargetType {
  VERSES
  PAGES
  JUZ
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SessionStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum RecitationRating {
  EXCELLENT
  VERY_GOOD
  GOOD
  ACCEPTABLE
  NEEDS_REVIEW
}

enum VisitType {
  ROUTINE
  FOLLOW_UP
  DIAGNOSTIC
  EMERGENCY
  COMPREHENSIVE
}

enum VisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum EvaluationLevel {
  EXCELLENT
  VERY_GOOD
  GOOD
  NEEDS_IMPROVEMENT
  NEEDS_INTERVENTION
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecommendationStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CriterionInputType {
  SCALE_5
  SCALE_10
  PERCENTAGE
  NUMERIC
  YES_NO
}

model Forum {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  logo      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches            Branch[]
  users               User[]
  roles               Role[]
  halaqas             Halaqa[]
  academicYears       AcademicYear[]
  educationalPlans    EducationalPlan[]
  attendanceSessions  AttendanceSession[]
  memorizationRecords MemorizationRecord[]
  revisionRecords     RevisionRecord[]
  evaluationTemplates EvaluationTemplate[]
  fieldVisits         FieldVisit[]
  recommendations     Recommendation[]

  @@index([isActive, deletedAt])
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  forumId   String    @db.Uuid
  name      String
  code      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  forum            Forum             @relation(fields: [forumId], references: [id], onDelete: Restrict)
  users            User[]
  halaqas          Halaqa[]
  roleScopes       UserRole[]
  educationalPlans EducationalPlan[]
  fieldVisits      FieldVisit[]
  recommendations  Recommendation[]

  @@unique([forumId, code])
  @@index([forumId, isActive, deletedAt])
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  forumId             String    @db.Uuid
  branchId            String?   @db.Uuid
  username            String
  displayName         String?
  usernameNormalized  String
  email               String?
  emailNormalized     String?
  phone               String?
  phoneNormalized     String?
  passwordHash        String?
  passwordChangedAt   DateTime?
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  forum                     Forum                    @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch                    Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  roles                     UserRole[]
  studentProfile            StudentProfile?
  parentProfile             ParentProfile?
  teacherProfile            TeacherProfile?
  supervisorProfile         SupervisorProfile?
  authSessions              AuthSession[]
  securityAuditLogs         SecurityAuditLog[]
  businessAuditLogs         AuditLog[]
  createdPlans              EducationalPlan[]        @relation("PlanCreator")
  recordedSessions          AttendanceSession[]      @relation("SessionRecorder")
  recordedAttendanceRecords AttendanceRecord[]       @relation("AttendanceRecorder")
  recordedMemorizations     MemorizationRecord[]     @relation("MemorizationRecorder")
  recordedRevisions         RevisionRecord[]         @relation("RevisionRecorder")
  createdFieldVisits        FieldVisit[]             @relation("FieldVisitCreator")
  createdRecommendations    Recommendation[]         @relation("RecommendationCreator")
  createdFollowUps          RecommendationFollowUp[] @relation("FollowUpCreator")
  createdSupervisorNotes    SupervisorVisitNote[]    @relation("SupervisorNoteCreator")

  @@unique([forumId, username])
  @@unique([forumId, usernameNormalized])
  @@unique([forumId, email])
  @@unique([forumId, emailNormalized])
  @@unique([forumId, phone])
  @@unique([forumId, phoneNormalized])
  @@index([forumId, branchId, isActive, deletedAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @db.VarChar(80)
  entityId    String?  @db.VarChar(128)
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(512)
  requestId   String?  @db.VarChar(128)
  createdAt   DateTime @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
}

model AuthSession {
  id                  String                   @id @default(uuid()) @db.Uuid
  userId              String                   @db.Uuid
  refreshTokenHash    String                   @unique
  tokenFamilyId       String                   @db.Uuid
  client              AuthClient
  lastUsedAt          DateTime?
  expiresAt           DateTime
  revokedAt           DateTime?
  revokedReason       SessionRevocationReason?
  replacedBySessionId String?                  @unique @db.Uuid
  ipAddress           String?                  @db.VarChar(45)
  userAgent           String?                  @db.VarChar(512)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy AuthSession? @relation("SessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces   AuthSession? @relation("SessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@index([tokenFamilyId])
}

model SecurityAuditLog {
  id          String             @id @default(uuid()) @db.Uuid
  actorUserId String?            @db.Uuid
  event       SecurityAuditEvent
  success     Boolean
  ipAddress   String?            @db.VarChar(45)
  userAgent   String?            @db.VarChar(512)
  requestId   String?            @db.VarChar(128)
  metadata    Json?
  createdAt   DateTime           @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([event, createdAt])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  forumId     String   @db.Uuid
  name        String
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  forum       Forum            @relation(fields: [forumId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([forumId, name])
  @@index([forumId, isActive])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  branchId  String?   @db.Uuid
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([userId, isActive])
  @@index([roleId, branchId, isActive])
}

model StudentProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  studentNumber  String?
  dateOfBirth    DateTime? @db.Date
  enrollmentDate DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardians           StudentGuardian[]
  halaqaMemberships   HalaqaMember[]
  educationalPlans    EducationalPlan[]
  attendanceRecords   AttendanceRecord[]
  memorizationRecords MemorizationRecord[]
  revisionRecords     RevisionRecord[]

  @@index([studentNumber])
}

model ParentProfile {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @db.Uuid
  occupation String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentGuardian[]
}

model TeacherProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  employeeNumber String?
  specialization String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  halaqas         HalaqaTeacher[]
  fieldVisits     FieldVisit[]
  recommendations Recommendation[]

  @@index([employeeNumber])
}

model SupervisorProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  employeeNumber String?
  specialization String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  halaqas         HalaqaSupervisor[]
  fieldVisits     FieldVisit[]
  recommendations Recommendation[]

  @@index([employeeNumber])
}

model StudentGuardian {
  id                      String               @id @default(uuid()) @db.Uuid
  studentId               String               @db.Uuid
  parentId                String               @db.Uuid
  relationship            GuardianRelationship @default(FATHER)
  isPrimary               Boolean              @default(true)
  canPickup               Boolean              @default(true)
  receivesAcademicReports Boolean              @default(true)
  receivesFinancialAlerts Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([parentId])
}

model Halaqa {
  id          String    @id @default(uuid()) @db.Uuid
  forumId     String    @db.Uuid
  branchId    String    @db.Uuid
  name        String
  code        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  forum               Forum                @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  members             HalaqaMember[]
  teachers            HalaqaTeacher[]
  supervisors         HalaqaSupervisor[]
  educationalPlans    EducationalPlan[]
  attendanceSessions  AttendanceSession[]
  memorizationRecords MemorizationRecord[]
  revisionRecords     RevisionRecord[]
  fieldVisits         FieldVisit[]
  recommendations     Recommendation[]

  @@unique([branchId, code])
  @@index([forumId, branchId, isActive, deletedAt])
}

model HalaqaMember {
  id        String             @id @default(uuid()) @db.Uuid
  halaqaId  String             @db.Uuid
  studentId String             @db.Uuid
  status    HalaqaMemberStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  endedAt   DateTime?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  halaqa  Halaqa         @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([halaqaId, isActive])
  @@index([studentId, isActive])
}

model HalaqaTeacher {
  id        String    @id @default(uuid()) @db.Uuid
  halaqaId  String    @db.Uuid
  teacherId String    @db.Uuid
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  halaqa  Halaqa         @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([halaqaId, isActive])
  @@index([teacherId, isActive])
}

model HalaqaSupervisor {
  id           String    @id @default(uuid()) @db.Uuid
  halaqaId     String    @db.Uuid
  supervisorId String    @db.Uuid
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  halaqa     Halaqa            @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  supervisor SupervisorProfile @relation(fields: [supervisorId], references: [id], onDelete: Restrict)

  @@index([halaqaId, isActive])
  @@index([supervisorId, isActive])
}

model AcademicYear {
  id        String    @id @default(uuid()) @db.Uuid
  forumId   String    @db.Uuid
  name      String    @db.VarChar(120)
  startsAt  DateTime  @db.Date
  endsAt    DateTime  @db.Date
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  forum Forum  @relation(fields: [forumId], references: [id], onDelete: Restrict)
  terms Term[]

  @@unique([forumId, name])
  @@index([forumId, isActive, deletedAt])
}

model Term {
  id             String    @id @default(uuid()) @db.Uuid
  academicYearId String    @db.Uuid
  name           String    @db.VarChar(120)
  startsAt       DateTime  @db.Date
  endsAt         DateTime  @db.Date
  order          Int       @default(1)
  isActive       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  plans        EducationalPlan[]

  @@index([academicYearId, isActive, deletedAt])
}

model EducationalPlan {
  id          String                @id @default(uuid()) @db.Uuid
  forumId     String                @db.Uuid
  branchId    String?               @db.Uuid
  halaqaId    String?               @db.Uuid
  studentId   String?               @db.Uuid
  termId      String?               @db.Uuid
  name        String                @db.VarChar(150)
  type        EducationalPlanType   @default(HIFZ)
  status      EducationalPlanStatus @default(DRAFT)
  startDate   DateTime?             @db.Date
  endDate     DateTime?             @db.Date
  createdById String?               @db.Uuid
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  forum   Forum                 @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch  Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  halaqa  Halaqa?               @relation(fields: [halaqaId], references: [id], onDelete: SetNull)
  student StudentProfile?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  term    Term?                 @relation(fields: [termId], references: [id], onDelete: SetNull)
  creator User?                 @relation("PlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items   EducationalPlanItem[]

  @@index([forumId, halaqaId, status])
  @@index([studentId, status])
}

model EducationalPlanItem {
  id          String         @id @default(uuid()) @db.Uuid
  planId      String         @db.Uuid
  type        PlanItemType   @default(MEMORIZATION)
  targetType  TargetType     @default(VERSES)
  surahNumber Int?
  fromAyah    Int?
  toAyah      Int?
  pageFrom    Int?
  pageTo      Int?
  juzNumber   Int?
  targetDate  DateTime?      @db.Date
  order       Int            @default(1)
  status      PlanItemStatus @default(PENDING)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  plan                EducationalPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  memorizationRecords MemorizationRecord[]
  revisionRecords     RevisionRecord[]

  @@index([planId, order])
}

model AttendanceSession {
  id           String        @id @default(uuid()) @db.Uuid
  forumId      String        @db.Uuid
  halaqaId     String        @db.Uuid
  sessionDate  DateTime      @db.Date
  startedAt    DateTime?
  endedAt      DateTime?
  status       SessionStatus @default(COMPLETED)
  notes        String?
  recordedById String?       @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  forum    Forum              @relation(fields: [forumId], references: [id], onDelete: Restrict)
  halaqa   Halaqa             @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  recorder User?              @relation("SessionRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  records  AttendanceRecord[]

  @@unique([halaqaId, sessionDate])
  @@index([forumId, halaqaId, sessionDate])
}

model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  sessionId    String           @db.Uuid
  studentId    String           @db.Uuid
  status       AttendanceStatus @default(PRESENT)
  notes        String?
  recordedById String?          @db.Uuid
  recordedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  session  AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student  StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recorder User?             @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([studentId, recordedAt])
}

model MemorizationRecord {
  id               String            @id @default(uuid()) @db.Uuid
  forumId          String            @db.Uuid
  halaqaId         String            @db.Uuid
  studentId        String            @db.Uuid
  planItemId       String?           @db.Uuid
  date             DateTime          @db.Date
  surahNumber      Int
  fromAyah         Int
  toAyah           Int
  pageFrom         Int?
  pageTo           Int?
  evaluationScore  Decimal           @default(100.0) @db.Decimal(5, 2)
  rating           RecitationRating?
  mistakesCount    Int               @default(0)
  teacherNotes     String?
  recordedById     String?           @db.Uuid
  clientMutationId String?           @unique @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  forum    Forum                @relation(fields: [forumId], references: [id], onDelete: Restrict)
  halaqa   Halaqa               @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  student  StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  planItem EducationalPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  recorder User?                @relation("MemorizationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([studentId, date])
  @@index([halaqaId, date])
}

model RevisionRecord {
  id               String            @id @default(uuid()) @db.Uuid
  forumId          String            @db.Uuid
  halaqaId         String            @db.Uuid
  studentId        String            @db.Uuid
  planItemId       String?           @db.Uuid
  date             DateTime          @db.Date
  surahNumber      Int?
  fromAyah         Int?
  toAyah           Int?
  pageFrom         Int?
  pageTo           Int?
  juzNumber        Int?
  evaluationScore  Decimal           @default(100.0) @db.Decimal(5, 2)
  rating           RecitationRating?
  mistakesCount    Int               @default(0)
  teacherNotes     String?
  recordedById     String?           @db.Uuid
  clientMutationId String?           @unique @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  forum    Forum                @relation(fields: [forumId], references: [id], onDelete: Restrict)
  halaqa   Halaqa               @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  student  StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  planItem EducationalPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  recorder User?                @relation("RevisionRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([studentId, date])
  @@index([halaqaId, date])
}

model EvaluationTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  forumId     String    @db.Uuid
  name        String
  description String?
  version     Int       @default(1)
  isActive    Boolean   @default(true)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  forum       Forum                  @relation(fields: [forumId], references: [id], onDelete: Restrict)
  axes        EvaluationAxis[]
  evaluations FieldVisitEvaluation[]

  @@index([forumId, isActive, isDefault])
}

model EvaluationAxis {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @db.Uuid
  name        String
  description String?
  weight      Decimal  @default(0.0) @db.Decimal(5, 2)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template EvaluationTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  criteria EvaluationCriterion[]

  @@index([templateId, order])
}

model EvaluationCriterion {
  id          String             @id @default(uuid()) @db.Uuid
  axisId      String             @db.Uuid
  name        String
  description String?
  type        CriterionInputType @default(SCALE_5)
  maxScore    Decimal            @default(5.0) @db.Decimal(5, 2)
  weight      Decimal?           @db.Decimal(5, 2)
  isRequired  Boolean            @default(true)
  order       Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  axis        EvaluationAxis        @relation(fields: [axisId], references: [id], onDelete: Cascade)
  evaluations CriterionEvaluation[]

  @@index([axisId, order])
}

model FieldVisit {
  id               String      @id @default(uuid()) @db.Uuid
  forumId          String      @db.Uuid
  branchId         String      @db.Uuid
  supervisorId     String      @db.Uuid
  halaqaId         String      @db.Uuid
  teacherId        String      @db.Uuid
  visitNumber      String      @db.VarChar(40)
  visitType        VisitType   @default(ROUTINE)
  status           VisitStatus @default(PLANNED)
  scheduledDate    DateTime?   @db.Date
  startedAt        DateTime?
  completedAt      DateTime?
  reason           String?
  summary          String?
  generalNotes     String?
  createdById      String?     @db.Uuid
  clientMutationId String?     @unique @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  forum           Forum                 @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supervisor      SupervisorProfile     @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  halaqa          Halaqa                @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  teacher         TeacherProfile        @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  creator         User?                 @relation("FieldVisitCreator", fields: [createdById], references: [id], onDelete: SetNull)
  evaluation      FieldVisitEvaluation?
  recommendations Recommendation[]
  notes           SupervisorVisitNote[]

  @@index([forumId, branchId, supervisorId, status])
  @@index([halaqaId, status])
  @@index([teacherId, status])
}

model FieldVisitEvaluation {
  id                   String           @id @default(uuid()) @db.Uuid
  visitId              String           @unique @db.Uuid
  templateId           String           @db.Uuid
  templateVersion      Int              @default(1)
  templateNameSnapshot String
  status               EvaluationStatus @default(DRAFT)
  totalScore           Decimal          @default(0.0) @db.Decimal(6, 2)
  maxPossibleScore     Decimal          @default(100.0) @db.Decimal(6, 2)
  percentage           Decimal          @default(0.0) @db.Decimal(5, 2)
  level                EvaluationLevel?
  strengths            String?
  improvementAreas     String?
  summary              String?
  submittedAt          DateTime?
  clientMutationId     String?          @unique @db.Uuid
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  visit               FieldVisit            @relation(fields: [visitId], references: [id], onDelete: Cascade)
  template            EvaluationTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  criteriaEvaluations CriterionEvaluation[]

  @@index([visitId, status])
}

model CriterionEvaluation {
  id                    String   @id @default(uuid()) @db.Uuid
  evaluationId          String   @db.Uuid
  criterionId           String   @db.Uuid
  axisNameSnapshot      String
  criterionNameSnapshot String
  maxScoreSnapshot      Decimal  @db.Decimal(5, 2)
  weightSnapshot        Decimal? @db.Decimal(5, 2)
  score                 Decimal  @db.Decimal(5, 2)
  notApplicable         Boolean  @default(false)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  evaluation FieldVisitEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  EvaluationCriterion  @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, criterionId])
  @@index([evaluationId])
}

model Recommendation {
  id               String                 @id @default(uuid()) @db.Uuid
  forumId          String                 @db.Uuid
  branchId         String                 @db.Uuid
  visitId          String?                @db.Uuid
  halaqaId         String                 @db.Uuid
  teacherId        String                 @db.Uuid
  supervisorId     String                 @db.Uuid
  title            String
  description      String
  domain           String?
  priority         RecommendationPriority @default(MEDIUM)
  status           RecommendationStatus   @default(OPEN)
  dueDate          DateTime?              @db.Date
  completedAt      DateTime?
  createdById      String?                @db.Uuid
  clientMutationId String?                @unique @db.Uuid
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?

  forum      Forum                    @relation(fields: [forumId], references: [id], onDelete: Restrict)
  branch     Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  visit      FieldVisit?              @relation(fields: [visitId], references: [id], onDelete: SetNull)
  halaqa     Halaqa                   @relation(fields: [halaqaId], references: [id], onDelete: Restrict)
  teacher    TeacherProfile           @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  supervisor SupervisorProfile        @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  creator    User?                    @relation("RecommendationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  followUps  RecommendationFollowUp[]

  @@index([forumId, branchId, supervisorId, status])
  @@index([teacherId, status])
  @@index([halaqaId, status])
}

model RecommendationFollowUp {
  id               String               @id @default(uuid()) @db.Uuid
  recommendationId String               @db.Uuid
  status           RecommendationStatus
  notes            String
  createdById      String?              @db.Uuid
  clientMutationId String?              @unique @db.Uuid
  createdAt        DateTime             @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  creator        User?          @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([recommendationId, createdAt])
}

model SupervisorVisitNote {
  id             String   @id @default(uuid()) @db.Uuid
  visitId        String   @db.Uuid
  text           String
  isConfidential Boolean  @default(false)
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())

  visit   FieldVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  creator User?      @relation("SupervisorNoteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([visitId])
}
